   }
 
+  private static RuForm synthetic(String root,String pos,String number,String morph,String lemma,int priority)
+  {
+    RuForm f=new RuForm();f.root=root;f.pos=pos;f.number=number;f.morph=morph;f.lemma=lemma;f.priority=priority;return f;
+  }
+
+  private RuForm exactNounConcept(String lemma)
+  {
+    RuForm f=aliasCyr.get(normRu(lemma));
+    if(f!=null&&f.pos.equals("noun"))return f;
+    f=formsCyr.get(normRu(lemma));
+    if(f!=null&&f.pos.equals("noun")&&f.morph.equals("nom"))return f;
+    return null;
+  }
+
+  /** Productive Russian -ск-/-н- adjective analysis. The source adjective is
+      reduced to a noun concept; Sil'mir then derives the adjective with -yb. */
+  private RuForm deriveRelationalAdjective(String word)
+  {
+    String w=normRu(word);
+    String[][] endings={
+      {"скими","pl"},{"ских","pl"},{"ские","pl"},{"ским","pl"},
+      {"ского","sg"},{"скому","sg"},{"ском","sg"},{"ской","sg"},{"скую","sg"},
+      {"ская","sg"},{"ское","sg"},{"ский","sg"},
+      {"ными","pl"},{"ных","pl"},{"ные","pl"},{"ным","pl"},
+      {"ного","sg"},{"ному","sg"},{"ном","sg"},{"ной","sg"},{"ную","sg"},
+      {"ная","sg"},{"ное","sg"},{"ный","sg"}
+    };
+    for(String[] x:endings)if(w.endsWith(x[0])&&w.length()>x[0].length()+1)
+    {
+      String base=w.substring(0,w.length()-x[0].length());
+      RuForm noun=exactNounConcept(base);
+      if(noun!=null)return synthetic(noun.root,"adjective",x[1],"derived_adj:yb",base+"ский",3);
+    }
+    return null;
+  }
+
+  /** Recover common Russian noun inflections from a known concept. This is a
+      fallback after the exact morphology index, not a replacement for it. */
+  private RuForm deriveKnownNounInflection(String word)
+  {
+    String w=normRu(word);
+    String[][] endings={
+      {"ами","pl","ins"},{"ями","pl","ins"},{"ах","pl","loc"},{"ях","pl","loc"},
+      {"ам","pl","dat"},{"ям","pl","dat"},{"ов","pl","gen"},{"ев","pl","gen"},
+      {"ом","sg","ins"},{"ем","sg","ins"},{"у","sg","dat"},{"ю","sg","dat"},
+      {"а","sg","gen"},{"я","sg","gen"},{"е","sg","loc"},{"ы","pl","nom"},{"и","pl","nom"}
+    };
+    for(String[] x:endings)if(w.endsWith(x[0])&&w.length()>x[0].length()+2)
+    {
+      String stem=w.substring(0,w.length()-x[0].length());
+      RuForm noun=exactNounConcept(stem);
+      if(noun!=null)return synthetic(noun.root,"noun",x[1],x[2],stem,5);
+    }
+    return null;
+  }
+
+  private static boolean looksRussianNounContext(List<String> t,int i)
+  {
+    String prev=previousWord(t,i);
+    if(PREP_SCAN.contains(prev)||prev.equals("время"))return true;
+    if(i>0)
+    {
+      String p=normRu(t.get(i-1));
+      if(p.matches(".*(?:ого|его|ой|ых|их|ыми|ими|скому|скому)$"))return true;
+    }
