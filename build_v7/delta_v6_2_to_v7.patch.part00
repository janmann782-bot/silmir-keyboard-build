+  /** Canonical concept layer. One Sil'mir root is one concept; Russian aliases
+      are merely surface realisations of that concept. */
+  private void loadConcepts(InputStream in) throws IOException
+  {
+    BufferedReader br=new BufferedReader(new InputStreamReader(in,StandardCharsets.UTF_8));
+    br.readLine();String line;
+    while((line=br.readLine())!=null)
+    {
+      String[] c=line.split("\t",-1);if(c.length<7)continue;
+      String root=rootRef(c[1]),pos=canonPos(c[2]),canonical=normRu(c[3]);
+      Lex e=lexget(root);
+      if(e!=null&&!canonical.isEmpty()&&(root.equals("kevir")||root.equals("Kevirytsyt")||root.equals("møcok")))e.primary=pooled(c[3]);
+      String aliases=c[6];
+      if(!canonical.isEmpty())aliases=canonical+(aliases.isEmpty()?"":"|"+aliases);
+      for(String a:aliases.split("\|"))
+      {
+        String k=normRu(a);if(k.isEmpty())continue;
+        RuForm f=new RuForm();f.root=root;f.pos=pos;f.number="sg";
+        f.morph=pos.equals("verb")?"verb:infinitive:3:active":"nom";
+        f.lemma=pooled(canonical.isEmpty()?k:canonical);
+        f.priority=(root.equals("kevir")||root.equals("Kevirytsyt")||root.equals("møcok"))?-8:40;
+        putCandidate(aliasCyr,aliasAmbCyr,k,f);
+      }
+    }
+    br.close();
+  }
+
   private static boolean sameCandidate(RuForm a,RuForm b)
   {
     return a.root.equals(b.root)&&a.pos.equals(b.pos)&&a.number.equals(b.number)&&a.morph.equals(b.morph);
